# Copy to backend/.env and fill in. Only the first block is required.

# ---------- Required ----------
ENVIRONMENT=production
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bookslot
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Where the React app is hosted (used for links in emails and for CORS)
FRONTEND_URL=https://app.yourdomain.com
# Public URL of this API (used for uploaded logo links)
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# Your platform admin login (created automatically on first start, then log in at /admin)
SUPER_ADMIN_EMAIL=you@yourdomain.com
# at least 10 characters
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Lee

# ---------- Optional ----------
# Extra allowed origins, comma separated (defaults to FRONTEND_URL)
# CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# Cookies: keep defaults for HTTPS. For local http development set COOKIE_SECURE=false
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# Google sign-in: create an OAuth "Web application" client ID in Google Cloud Console and add
# your FRONTEND_URL to "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=

# Email (https://resend.com) - confirmations, reminders, password resets
RESEND_API_KEY=
SENDER_EMAIL=BookSlot <bookings@yourdomain.com>
PLATFORM_NAME=BookSlot

# SMS (https://twilio.com) - SMS add-on reminders and AI receptionist by SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Per-business numbers (SMS and WhatsApp) are set in /admin. In Twilio, point each number's
# "A message comes in" webhook to <BACKEND_PUBLIC_URL>/api/moltbot/webhook/incoming-sms (same URL for WhatsApp).
SMS_ADDON_PRICE=10

# AI receptionist - set ONE of these keys (provider is picked automatically)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_PROVIDER=openai          # or anthropic
# AI_MODEL=gpt-4o-mini         # default for OpenAI; claude-haiku-4-5 for Anthropic

# File uploads: local folder by default. On hosts without a persistent disk use S3-compatible
# storage (AWS S3, Cloudflare R2, DigitalOcean Spaces...) by setting S3_BUCKET + AWS credentials.
# UPLOAD_DIR=./uploads
S3_BUCKET=
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MAX_UPLOAD_MB=5

# Background reminder job (checks every 5 minutes)
# ENABLE_REMINDERS=true
# REMINDER_INTERVAL_SECONDS=300
